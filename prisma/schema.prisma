generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  nickname        String?
  phone           String    @unique
  email           String?   @unique
  password        String?                       // 密码哈希
  points          Int       @default(0)
  level           String    @default("NORMAL")
  referralCode    String?   @unique
  referrerId      Int?
  isVerified      Boolean   @default(false)
  role            String    @default("USER")   // USER, MERCHANT, RIDER, ADMIN
  addresses       Address[]
  orders          MainOrder[]
  referrals       User[]    @relation("Referrals")
  referrer        User?     @relation("Referrals", fields: [referrerId], references: [id])
  auditLogs       AuditLog[]
  coupons         UserCoupon[]
  notifications   Notification[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  detail    String
  lat       Float
  lng       Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt
}

model Merchant {
  id              Int       @id @default(autoincrement())
  name            String
  stallNo         String    @unique
  status          String    @default("CLOSED")
  category        String?
  governmentId    String?   @unique
  licenseStatus   String    @default("PENDING")
  licenseUrl      String?
  rating          Float     @default(5.0)
  totalOrders     Int       @default(0)
  totalRevenue    Decimal   @default(0)
  platformFeeRate Float     @default(0.05)
  balance         Decimal   @default(0)
  products        Product[]
  subOrders       SubOrder[]
  withdrawals     Withdrawal[]
  auditLogs       AuditLog[]
  coupons         Coupon[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Product {
  id          Int      @id @default(autoincrement())
  merchantId  Int
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  name        String
  price       Decimal
  description String?
  image       String?
  stock       Int      @default(999)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime  @updatedAt
}

model MainOrder {
  id              Int        @id @default(autoincrement())
  orderNo         String     @unique
  userId          Int
  user            User       @relation(fields: [userId], references: [id])
  totalAmount     Decimal
  platformFee     Decimal    @default(0)
  merchantAmount  Decimal    @default(0)
  discountAmount  Decimal    @default(0)
  couponId        Int?
  coupon          Coupon?    @relation(fields: [couponId], references: [id])
  status          String     @default("PENDING_PAYMENT")
  refundStatus    String     @default("NONE")
  refundAmount    Decimal    @default(0)
  subOrders       SubOrder[]
  payment         Payment?
  refund          OrderRefund?
  auditLogs       AuditLog[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model SubOrder {
  id          Int       @id @default(autoincrement())
  subOrderNo  String    @unique
  mainOrderId Int
  mainOrder   MainOrder @relation(fields: [mainOrderId], references: [id])
  merchantId  Int
  merchant    Merchant  @relation(fields: [merchantId], references: [id])
  status      String    @default("PENDING_ACCEPT")
  delivery    Delivery?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Rider {
  id         Int        @id @default(autoincrement())
  name       String
  phone      String     @unique
  status     String     @default("OFFLINE")
  rating     Float      @default(5.0)
  totalDeliveries Int    @default(0)
  deliveries Delivery[]
  auditLogs  AuditLog[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Delivery {
  id         Int      @id @default(autoincrement())
  subOrderId Int      @unique
  subOrder   SubOrder @relation(fields: [subOrderId], references: [id])
  riderId    Int?
  rider      Rider?   @relation(fields: [riderId], references: [id])
  status     String   @default("PENDING_ASSIGN")
  pickupTime DateTime?
  deliveryTime DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime  @updatedAt
}

model Payment {
  id              Int       @id @default(autoincrement())
  mainOrderId     Int       @unique
  mainOrder       MainOrder @relation(fields: [mainOrderId], references: [id])
  transactionId   String?   @unique
  amount          Decimal
  method          String    @default("WECHAT")
  status          String    @default("PENDING")
  verifySignature Boolean   @default(false)
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model OrderRefund {
  id              Int       @id @default(autoincrement())
  mainOrderId     Int       @unique
  mainOrder       MainOrder @relation(fields: [mainOrderId], references: [id])
  refundNo        String    @unique
  amount          Decimal
  reason          String
  status          String    @default("PENDING")
  approvedBy      String?
  approvedAt      DateTime?
  refundedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Withdrawal {
  id              Int       @id @default(autoincrement())
  merchantId      Int
  merchant        Merchant  @relation(fields: [merchantId], references: [id])
  withdrawalNo    String    @unique
  amount          Decimal
  status          String    @default("PENDING")
  bankAccount     String?
  approvedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id              Int       @id @default(autoincrement())
  userId          Int?
  user            User?     @relation(fields: [userId], references: [id])
  merchantId      Int?
  merchant        Merchant? @relation(fields: [merchantId], references: [id])
  riderId         Int?
  rider           Rider?    @relation(fields: [riderId], references: [id])
  mainOrderId     Int?
  mainOrder       MainOrder? @relation(fields: [mainOrderId], references: [id])
  action          String
  resource        String
  resourceId      Int?
  oldValue        String?
  newValue        String?
  ipAddress       String?
  userAgent       String?
  status          String    @default("SUCCESS")
  createdAt       DateTime  @default(now())
}

model Referral {
  id              Int       @id @default(autoincrement())
  referrerId      Int
  referredUserId  Int
  reward          Decimal   @default(0)
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Coupon {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  merchantId      Int?
  merchant        Merchant? @relation(fields: [merchantId], references: [id])
  name            String
  description     String?
  type            String                        // DISCOUNT, FULL_REDUCTION
  discountValue   Decimal                       // 折扣值或满减金额
  minOrderAmount  Decimal   @default(0)         // 最低订单金额
  maxDiscountAmount Decimal? @default(0)        // 最大折扣金额（仅折扣券）
  quantity        Int                           // 总数量
  usedQuantity    Int       @default(0)         // 已使用数量
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean   @default(true)
  userCoupons     UserCoupon[]
  orders          MainOrder[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model UserCoupon {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  couponId        Int
  coupon          Coupon    @relation(fields: [couponId], references: [id])
  isUsed          Boolean   @default(false)
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Notification {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  type            String                        // ORDER_STATUS, COUPON, SYSTEM
  title           String
  content         String
  isRead          Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
