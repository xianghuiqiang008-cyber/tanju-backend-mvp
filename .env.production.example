# 复制为 .env.production 后填写，禁止把真实密钥提交到 Git
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/tanju_mvp
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRE=7d
LOG_LEVEL=info
LOG_DIR=/app/logs
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
# 仅在实际接入支付时填写
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_APP_ID=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
